#!/usr/bin/env python3
"""screenshot — a notification for each new screenshot; a click shows it in the file manager.

zen-screenshot.path runs this when ~/Pictures/Screenshots changes (Niri saves
there and copies the picture to the clipboard).
"""
import os
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path.home() / ".local/lib/zen"))
import zen  # noqa: E402
from zen import _, run  # noqa: E402

DIR = Path.home() / "Pictures/Screenshots"
LAST = zen.RUNTIME / "zen-screenshot-last"
PICTURES = {".png", ".jpg", ".jpeg", ".webp"}


def notify(path):
    """Wait for the notification; its default action opens the folder with the file selected."""
    res = run("notify-send", "-a", _("Screenshot"), "-i", str(path),
              "-A", f"default={_('Show in folder')}",
              _("Screenshot saved"), f"{path.name}\n{_('Copied to the clipboard')}")
    if res.stdout.strip() == "default":
        run("busctl", "--user", "call", "org.freedesktop.FileManager1", "/org/freedesktop/FileManager1",
            "org.freedesktop.FileManager1", "ShowItems", "ass", "1", path.as_uri(), "")
    return 0


def main():
    if sys.argv[1:2] == ["notify"] and len(sys.argv) == 3:
        return notify(Path(sys.argv[2]))
    try:
        since = LAST.stat().st_mtime
    except OSError:
        since = time.time() - 10
    LAST.touch()
    new = sorted((p for p in DIR.glob("*") if p.suffix.lower() in PICTURES and p.stat().st_mtime > since),
                 key=lambda p: p.stat().st_mtime)
    for path in new:
        subprocess.Popen([sys.executable, os.path.realpath(__file__), "notify", str(path)],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
