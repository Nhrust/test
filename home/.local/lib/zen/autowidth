#!/usr/bin/env python3
import json
import subprocess
import sys
import time

FULL = 0.75
windows = {}
partner = {}
pending = set()
shrunk_by_us = set()
saved = {}          # window -> share of the screen width it had before Mod+[ / ] put it into a stack
stacked = {}        # window -> was it in a column with others at the last look
focused_id = None
last_close = 0.0


def log(*parts):
    print("autowidth:", *parts, file=sys.stderr, flush=True)


def niri(*args):
    return subprocess.run(["niri", "msg", *args], capture_output=True, text=True)


def output_size():
    res = niri("--json", "focused-output")
    try:
        logical = json.loads(res.stdout)["logical"]
        return logical["width"], logical["height"]
    except (ValueError, KeyError, TypeError):
        return None, None


def output_width():
    return output_size()[0]


def is_fullscreen(w):
    width, height = output_size()
    if not width:
        return False
    tile_w, tile_h = (w.get("layout") or {}).get("tile_size", (0, 0))
    return tile_w >= width - 1 and tile_h >= height - 1


def set_width(win_id, value):
    niri("action", "set-window-width", "--id", str(win_id), value)


def column_windows(workspace_id, column):
    out = []
    for w in windows.values():
        pos = (w.get("layout") or {}).get("pos_in_scrolling_layout")
        if w.get("workspace_id") == workspace_id and not w.get("is_floating") and pos and pos[0] == column:
            out.append(w)
    return out


def on_new_window(w):
    pos = (w.get("layout") or {}).get("pos_in_scrolling_layout")
    if w.get("is_floating"):
        return
    if not pos:
        pending.add(w["id"])
        return
    col = pos[0]
    if len(column_windows(w["workspace_id"], col)) != 1:
        return
    left = column_windows(w["workspace_id"], col - 1) if col > 1 else []
    if left and not stack_is_free(w["workspace_id"], col - 1):
        # the column on the left is already the second half of a pair (stack or not)
        set_width(w["id"], "100%")
        return
    if len(left) == 1 and left[0]["id"] not in partner and not is_fullscreen(left[0]):
        width = output_width()
        if width and left[0]["layout"]["tile_size"][0] >= FULL * width:
            shrunk_by_us.add(left[0]["id"])
            set_width(left[0]["id"], "50%")
            partner[left[0]["id"]] = w["id"]
            partner[w["id"]] = left[0]["id"]
            return
        if width:
            partner[left[0]["id"]] = w["id"]
            partner[w["id"]] = left[0]["id"]
            return
    if len(left) > 1 and stack_is_free(w["workspace_id"], col - 1) and not is_fullscreen(left[0]):
        # a stack of windows already fills a half: the new window takes the other half
        width = output_width()
        if width:
            if left[0]["layout"]["tile_size"][0] >= FULL * width:
                set_width(left[0]["id"], "50%")
            set_width(w["id"], "50%")
            log(f"window {w['id']} opened beside a stack: half of the screen")
            return
    set_width(w["id"], "100%")


def stack_is_free(workspace_id, col):
    """No half-width column on the left of this one: it is not a half of a pair yet."""
    before = column_windows(workspace_id, col - 1) if col > 1 else []
    width = output_width()
    return not before or not width or is_fullscreen(before[0]) \
        or before[0]["layout"]["tile_size"][0] >= FULL * width


def rebuild_pairs():
    width = output_width()
    if not width:
        return
    singles = {}
    for (ws, col), group in _columns().items():
        if len(group) == 1:
            singles[(ws, col)] = group[0]
    for (ws, col) in sorted(singles):
        a, b = singles.get((ws, col)), singles.get((ws, col + 1))
        if not a or not b or a["id"] in partner or b["id"] in partner:
            continue
        if all(x["layout"]["tile_size"][0] < FULL * width and not is_fullscreen(x) for x in (a, b)):
            partner[a["id"]] = b["id"]
            partner[b["id"]] = a["id"]


def _columns():
    cols = {}
    for w in windows.values():
        pos = (w.get("layout") or {}).get("pos_in_scrolling_layout")
        if pos and not w.get("is_floating"):
            cols.setdefault((w.get("workspace_id"), pos[0]), []).append(w)
    return cols


def show_pair():
    res = niri("--json", "focused-window")
    try:
        focused = json.loads(res.stdout)
    except ValueError:
        return
    if not focused or focused["id"] not in partner:
        return
    niri("action", "focus-window", "--id", str(partner[focused["id"]]))
    niri("action", "focus-window", "--id", str(focused["id"]))


def reveal(win_id):
    """Bring the window and the column next to it into view, the focus stays on the window."""
    w = windows.get(win_id)
    pos = (w or {}).get("layout", {}).get("pos_in_scrolling_layout")
    if not pos:
        return
    for col in (pos[0] - 1, pos[0] + 1):
        mates = [m for m in column_windows(w["workspace_id"], col) if m["id"] != win_id]
        if mates:
            niri("action", "focus-window", "--id", str(mates[0]["id"]))
            niri("action", "focus-window", "--id", str(win_id))
            return


def share_to_percent(share):
    if abs(share - 0.5) < 0.06:
        return 50
    if share > 0.9:
        return 100
    return max(10, round(share * 100))


def track_stacks(changed, old_widths):
    """Mod+[ / ] on the focused window: remember its width when it joins a column of
    others, give it back when it leaves; keep the pair in view both ways."""
    width = output_width()
    for win_id in changed:
        w = windows.get(win_id)
        pos = ((w or {}).get("layout") or {}).get("pos_in_scrolling_layout")
        if not pos or w.get("is_floating"):
            continue
        now = len(column_windows(w["workspace_id"], pos[0])) > 1
        was = stacked.get(win_id, False)
        stacked[win_id] = now
        if now == was or win_id != focused_id:
            continue
        if now:
            if width and old_widths.get(win_id):
                saved[win_id] = old_widths[win_id] / width
            log(f"window {win_id} joined a column, width {saved.get(win_id)} remembered")
            reveal(win_id)
        elif win_id in saved and time.monotonic() - last_close > 1:
            share = saved.pop(win_id)
            log(f"window {win_id} left the column, width back to {share_to_percent(share)}%")
            set_width(win_id, f"{share_to_percent(share)}%")
            reveal(win_id)


def on_resized(win_id, old_width, new_width):
    if win_id not in partner:
        return
    width = output_width()
    if not width or not (old_width >= FULL * width > new_width):
        return
    if win_id in shrunk_by_us:
        shrunk_by_us.discard(win_id)
        return
    other = windows.get(partner[win_id])
    if other and other["layout"]["tile_size"][0] < FULL * width:
        show_pair()


def on_closed(win_id, user_closed=False):
    global last_close
    last_close = time.monotonic()
    windows.pop(win_id, None)
    pending.discard(win_id)
    shrunk_by_us.discard(win_id)
    saved.pop(win_id, None)
    stacked.pop(win_id, None)
    other = partner.pop(win_id, None)
    if other is not None:
        partner.pop(other, None)
        if other in windows:
            set_width(other, "100%")
    elif user_closed:
        show_pair()


def toggle():
    res = niri("--json", "focused-window")
    try:
        focused = json.loads(res.stdout)
    except ValueError:
        return 1
    if not focused or focused.get("is_floating"):
        return 0
    width = output_width()
    tile_width = (focused.get("layout") or {}).get("tile_size", [0])[0]
    target = "50%" if width and tile_width >= FULL * width else "100%"
    niri("action", "set-column-width", target)
    return 0


def main():
    global focused_id
    if sys.argv[1:] == ["toggle"]:
        return toggle()
    proc = subprocess.Popen(["niri", "msg", "--json", "event-stream"],
                            stdout=subprocess.PIPE, text=True)
    for line in proc.stdout:
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if "WindowsChanged" in event:
            windows.clear()
            for w in event["WindowsChanged"]["windows"]:
                windows[w["id"]] = w
            for i in list(partner):
                if i not in windows:
                    on_closed(i)
            rebuild_pairs()
            for i in windows:
                if windows[i].get("is_focused"):
                    focused_id = i
                pos = (windows[i].get("layout") or {}).get("pos_in_scrolling_layout")
                stacked[i] = bool(pos) and len(column_windows(windows[i]["workspace_id"], pos[0])) > 1
        elif "WindowFocusChanged" in event:
            focused_id = event["WindowFocusChanged"].get("id")
        elif "WindowOpenedOrChanged" in event:
            w = event["WindowOpenedOrChanged"]["window"]
            is_new = w["id"] not in windows
            windows[w["id"]] = w
            if is_new:
                stacked[w["id"]] = False
            if w.get("is_focused"):
                focused_id = w["id"]
            if is_new or (w["id"] in pending and w["layout"].get("pos_in_scrolling_layout")):
                pending.discard(w["id"])
                on_new_window(w)
        elif "WindowLayoutsChanged" in event:
            resized = []
            old_widths = {}
            for win_id, layout in event["WindowLayoutsChanged"]["changes"]:
                if win_id in windows:
                    old = (windows[win_id].get("layout") or {}).get("tile_size", (0, 0))[0]
                    windows[win_id]["layout"] = layout
                    resized.append((win_id, old, layout["tile_size"][0]))
                    old_widths[win_id] = old
            for win_id, old, new in resized:
                on_resized(win_id, old, new)
            track_stacks([r[0] for r in resized], old_widths)
            for win_id in list(pending):
                if (windows.get(win_id, {}).get("layout") or {}).get("pos_in_scrolling_layout"):
                    pending.discard(win_id)
                    on_new_window(windows[win_id])
        elif "WindowClosed" in event:
            on_closed(event["WindowClosed"]["id"], user_closed=True)
    return proc.wait()


if __name__ == "__main__":
    sys.exit(main())
