#!/usr/bin/env python3
"""level-icon — Waybar image module: volume and brightness level icons.

  level volume
  level brightness
"""
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path.home() / ".local/lib/zen"))
import zen  # noqa: E402

ON, OFF = zen.palette()["fg"], zen.palette()["line"]

LEVELS = 5
DIR = zen.RUNTIME / f"zen-level-{LEVELS + 1}b-{ON.lstrip('#')}{OFF.lstrip('#')}"

SPEAKER = "M3,9V15H7L12,20V4L7,9H3Z"
MUTED = ("M12,4L9.91,6.09L12,8.18M4.27,3L3,4.27L7.73,9H3V15H7L12,20V13.27L16.25,17.53"
         "C15.58,18.04 14.83,18.46 14,18.7V20.77C15.38,20.45 16.63,19.82 17.68,18.96L19.73,21"
         "L21,19.73L12,10.73M19,12C19,12.94 18.8,13.82 18.46,14.64L19.97,16.15C20.62,14.91 21,13.5"
         " 21,12C21,7.72 18,4.14 14,3.23V5.29C16.89,6.15 19,8.83 19,12M16.5,12C16.5,10.23 15.5,8.71"
         " 14,7.97V10.18L16.45,12.63C16.5,12.43 16.5,12.21 16.5,12Z")
GEAR = ("M12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18M20,15.31"
        "L23.31,12L20,8.69V4H15.31L12,0.69L8.69,4H4V8.69L0.69,12L4,15.31V20H8.69L12,23.31"
        "L15.31,20H20V15.31Z")

HEAD = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">'


INNER = ("M16.5,12C16.5,10.23 15.5,8.71 14,7.97V16C15.5,15.29 16.5,13.76 16.5,12")
OUTER = ("M14,3.23V5.29C16.89,6.15 19,8.83 19,12C19,15.17 16.89,17.84 14,18.7V20.77"
         "C18,19.86 21,16.28 21,12C21,7.72 18,4.14 14,3.23")
REACH = {0: (0, 0), 1: (2.2, 0), 2: (5, 0), 3: (5, 3.5), 4: (5, 6.2), 5: (5, 9)}


def volume_svg(level):
    hi, ho = REACH[level]
    clip = "".join(f'<clipPath id="{n}"><rect x="0" y="{12 - h:.2f}" width="24" height="{2 * h:.2f}"/>'
                   f'</clipPath>' for n, h in (("i", hi), ("o", ho)))
    return (f'{HEAD}<defs>{clip}</defs><path fill="{ON}" d="{SPEAKER}"/>'
            f'<path fill="{OFF}" d="{INNER}"/><path fill="{OFF}" d="{OUTER}"/>'
            f'<path fill="{ON}" clip-path="url(#i)" d="{INNER}"/>'
            f'<path fill="{ON}" clip-path="url(#o)" d="{OUTER}"/></svg>\n')


def muted_svg():
    return f'{HEAD}<path fill="{OFF}" d="{MUTED}"/></svg>\n'


def brightness_svg(level):
    h = 8 * level / LEVELS
    return (f'{HEAD}<defs><clipPath id="c"><rect x="0" y="{16 - h:.2f}" width="24" height="{h:.2f}"/>'
            f'</clipPath></defs><path fill="{ON}" d="{GEAR}"/>'
            f'<circle cx="12" cy="12" r="4" fill="{OFF}"/>'
            f'<circle cx="12" cy="12" r="4" fill="{ON}" clip-path="url(#c)"/></svg>\n')


def write_all():
    DIR.mkdir(parents=True, exist_ok=True)
    for level in range(LEVELS + 1):
        (DIR / f"volume-{level}.svg").write_text(volume_svg(level))
        (DIR / f"brightness-{level}.svg").write_text(brightness_svg(level))
    (DIR / "volume-muted.svg").write_text(muted_svg())


def level(percent):
    return max(0, min(LEVELS, -(-int(round(percent)) * LEVELS // 100)))


def volume():
    out = subprocess.run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"],
                         capture_output=True, text=True).stdout
    if "MUTED" in out:
        return DIR / "volume-muted.svg"
    m = re.search(r"([\d.]+)", out)
    return DIR / f"volume-{level(float(m.group(1)) * 100 if m else 0)}.svg"


def brightness():
    out = subprocess.run(["brightnessctl", "--class=backlight", "-m"],
                         capture_output=True, text=True).stdout.split(",")
    pct = int(out[3].rstrip("%")) if len(out) > 3 else 0
    return DIR / f"brightness-{level(pct)}.svg"


def main():
    what = {"volume": volume, "brightness": brightness}.get(sys.argv[1] if len(sys.argv) > 1 else "")
    if not what:
        sys.exit(__doc__)
    if not (DIR / "volume-muted.svg").exists():
        write_all()
    print(what())


if __name__ == "__main__":
    main()
