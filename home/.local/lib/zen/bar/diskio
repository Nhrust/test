#!/usr/bin/env python3
"""diskio — Waybar module: read and write speed of the disks, "↓3.1M ↑0.2M"."""
import os
import time

INTERVAL = 2


def disks():
    """Whole disks with a device behind them (no partitions, loop, zram)."""
    return {d for d in os.listdir("/sys/block") if os.path.exists(f"/sys/block/{d}/device")}


def sectors():
    read = written = 0
    whole = disks()
    with open("/proc/diskstats") as f:
        for line in f:
            p = line.split()
            if len(p) > 9 and p[2] in whole:
                read += int(p[5])
                written += int(p[9])
    return read * 512, written * 512


def human(rate):
    for unit in ("B", "K", "M", "G"):
        if rate < 1024 or unit == "G":
            return f"{rate:.1f}{unit}" if unit != "B" else f"{rate:.0f}B"
        rate /= 1024


prev = sectors()
while True:
    time.sleep(INTERVAL)
    cur = sectors()
    r, w = ((c - p) / INTERVAL for c, p in zip(cur, prev))
    print(f"↓{human(max(r, 0))} ↑{human(max(w, 0))}", flush=True)
    prev = cur
