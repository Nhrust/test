#!/bin/sh
# battery — notify when UPower reports the battery as critically low.
. "$HOME/.local/lib/zen/zen.sh"
gdbus monitor --system --dest org.freedesktop.UPower \
	--object-path /org/freedesktop/UPower/devices/DisplayDevice |
while read -r line; do
	case "$line" in
		*"'WarningLevel': <uint32 4>"*)
			notify-send -u critical "$(gettext "Battery is critically low")" \
				"$(gettext "Connect the charger.")" ;;
	esac
done
