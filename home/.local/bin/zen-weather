#!/usr/bin/env python3
"""zen-weather — Waybar module: weather icon and temperature from wttr.in."""
import datetime
import json
import os
import re
import sys
import urllib.parse
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share") / "zen/python"))
import zen  # noqa: E402

ICONS = {
    "clear": ("\U000f0599", "\U000f0594"),
    "partly": ("\U000f0595", "\U000f0f31"),
    "cloudy": ("\U000f0590", "\U000f0590"),
    "fog": ("\U000f0591", "\U000f0591"),
    "rain": ("\U000f0597", "\U000f0597"),
    "heavy": ("\U000f0596", "\U000f0596"),
    "snow": ("\U000f0598", "\U000f0598"),
    "storm": ("\U000f0593", "\U000f0593"),
}

KINDS = {
    "clear": {113},
    "partly": {116},
    "cloudy": {119, 122},
    "fog": {143, 248, 260},
    "rain": {176, 185, 263, 266, 281, 284, 293, 296, 299, 302, 311, 353},
    "heavy": {305, 308, 314, 356, 359},
    "snow": {179, 182, 227, 230, 317, 320, 323, 326, 329, 332, 335, 338,
             350, 362, 365, 368, 371, 374, 377},
    "storm": {200, 386, 389, 392, 395},
}


def kind(code):
    return next((k for k, codes in KINDS.items() if code in codes), "cloudy")


def wwo_time(s):
    """wttr.in gives "07:41 AM" in English regardless of the locale."""
    m = re.match(r"(\d+):(\d+)\s*([AP]M)", s.strip(), re.I)
    if not m:
        raise ValueError(s)
    return datetime.time(int(m.group(1)) % 12 + (12 if m.group(3).upper() == "PM" else 0), int(m.group(2)))


def is_day(astronomy):
    now = datetime.datetime.now().time()
    return wwo_time(astronomy["sunrise"]) <= now < wwo_time(astronomy["sunset"])


def main():
    where = urllib.parse.quote(zen.settings().get("weather", "location").strip())
    req = urllib.request.Request(f"https://wttr.in/{where}?format=j2", headers={"User-Agent": "curl"})
    with urllib.request.urlopen(req, timeout=15) as r:
        data = json.load(r)
    cur = data["current_condition"][0]
    day, night = ICONS[kind(int(cur["weatherCode"]))]
    try:
        icon = day if is_day(data["weather"][0]["astronomy"][0]) else night
    except (KeyError, IndexError, ValueError):
        icon = day
    t = int(cur["temp_C"] if zen.metric() else cur["temp_F"])
    sign = "+" if t > 0 else "−" if t < 0 else ""
    print(f"{icon} {sign}{abs(t)}°")


try:
    main()
except Exception as err:
    print("")
    print(f"zen-weather: {err}", file=sys.stderr)
