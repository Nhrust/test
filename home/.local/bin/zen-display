#!/usr/bin/env python3
"""zen-display — monitors, layout, brightness and caffeine in one Rofi menu.

  zen-display            open the menu (a second call closes it)
  zen-display restore    restore brightness and mirroring of the current place (kanshi exec)
  zen-display caffeine   Waybar module: caffeine icon while it is on
"""
import hashlib
import html
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share") / "zen/python"))
import zen  # noqa: E402
from zen import _, run  # noqa: E402

SELF = os.path.realpath(__file__)
STATE = zen.CONFIG_HOME / "zen/displays.json"
OLD_STATE = zen.CONFIG_HOME / "theme/displays.json"
KANSHI = zen.CONFIG_HOME / "kanshi/config"
THEME = zen.CONFIG_HOME / "rofi/display.rasi"
MIRROR_APP = "at.yrlf.wl_mirror"
CAFFEINE = "zen-caffeine.service"
CAFFEINE_SIGNAL = 10
COFFEE = "\U000F0176"

SCALES = [1.0, 1.25, 1.5, 1.75, 2.0]
SIDES = [("left", _("Left")), ("right", _("Right")), ("above", _("Above")), ("below", _("Below"))]
SIDE_TEXT = {"left": _("left of {}"), "right": _("right of {}"),
             "above": _("above {}"), "below": _("below {}")}
ALIGNS = [("center", _("centered")), ("start", _("edge"))]
ACCENT = zen.palette()["accent"]


def where(side, anchor):
    return SIDE_TEXT[side or "right"].format(short(anchor))

INIT, SELECT, ESC, LEFT, RIGHT = 0, 1, 12, 13, 14
DDC_CACHE = zen.RUNTIME / "zen-display-ddc.json"
MIRRORS = zen.RUNTIME / "zen-display-mirror.json"


def niri(*args):
    return run("niri", "msg", *args)


def outputs():
    try:
        return json.loads(niri("--json", "outputs").stdout)
    except ValueError:
        return {}


def is_laptop(name):
    return name.startswith(("eDP", "LVDS", "DSI"))


def ident(o):
    if is_laptop(o["name"]):
        return o["name"]
    return f'{o.get("make") or "Unknown"} {o.get("model") or "Unknown"} {o.get("serial") or "Unknown"}'


def title(o):
    return " ".join(x for x in (o.get("make"), o.get("model")) if x and x != "Unknown") or o["name"]


def short(o):
    return o["name"]


def mode_str(m):
    return f'{m["width"]}x{m["height"]}@{m["refresh_rate"] / 1000:g}'


def mode_label(m):
    return f'{m["width"]}×{m["height"]} · {round(m["refresh_rate"] / 1000)} {_("Hz")}'


def current_mode(o):
    i = o.get("current_mode")
    return o["modes"][i] if i is not None and o.get("modes") else None


def enabled(o):
    return o.get("logical") is not None


def ordered(outs):
    return sorted(outs.values(), key=lambda o: (not is_laptop(o["name"]), o["name"]))


def load_state():
    if not STATE.exists() and OLD_STATE.exists():
        STATE.parent.mkdir(parents=True, exist_ok=True)
        OLD_STATE.rename(STATE)
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {}


def save_state(state):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(state, ensure_ascii=False, indent=2) + "\n")


def place_key(outs):
    return " + ".join(sorted(ident(o) for o in outs.values()))


def default_cfg(o, laptop_id):
    m = current_mode(o)
    return {
        "enabled": enabled(o),
        "mode": mode_str(m) if m else None,
        "scale": (o.get("logical") or {}).get("scale", 1.0),
        "rel": None if is_laptop(o["name"]) else laptop_id,
        "side": None if is_laptop(o["name"]) else "right",
        "align": "center",
        "brightness": None,
    }


def current_place(outs, state):
    key = place_key(outs)
    place = state.setdefault(key, {"outputs": {}, "preset": None})
    laptop_id = next((ident(o) for o in outs.values() if is_laptop(o["name"])), None)
    for o in outs.values():
        place["outputs"].setdefault(ident(o), default_cfg(o, laptop_id))
    return key, place


def write_kanshi(state):
    lines = ["# Generated by zen-display; rewritten on every change in its menu.", ""]
    for key, place in sorted(state.items()):
        name = "zen-" + hashlib.sha1(key.encode()).hexdigest()[:8]
        lines.append(f"# {key}")
        lines.append(f"profile {name} {{")
        for oid, cfg in sorted(place["outputs"].items()):
            if not cfg["enabled"]:
                lines.append(f'    output "{oid}" disable')
                continue
            parts = [f'    output "{oid}" enable']
            if cfg.get("mode"):
                parts.append(f'mode {cfg["mode"]}Hz')
            if cfg.get("pos"):
                parts.append(f'position {cfg["pos"][0]},{cfg["pos"][1]}')
            parts.append(f'scale {cfg["scale"]:g}')
            lines.append(" ".join(parts))
        lines.append(f"    exec {SELF} restore")
        lines.append("}")
        lines.append("")
    KANSHI.parent.mkdir(parents=True, exist_ok=True)
    KANSHI.write_text("\n".join(lines))


def chain_ok(place, oid, anchor):
    seen = set()
    while anchor and anchor not in seen:
        if anchor == oid:
            return False
        seen.add(anchor)
        anchor = place["outputs"].get(anchor, {}).get("rel")
    return True


def positions(place, on):
    if not on:
        return {}
    root = next((i for i, o in on.items() if is_laptop(o["name"])), sorted(on)[0])
    pos = {root: (0, 0)}
    pending = [i for i in on if i != root]
    for _x in range(len(pending) + 1):
        for oid in list(pending):
            cfg = place["outputs"][oid]
            anchor = cfg.get("rel")
            if anchor not in on or anchor == oid:
                anchor = root
            if anchor not in pos:
                continue
            ax, ay = pos[anchor]
            aw, ah = on[anchor]["logical"]["width"], on[anchor]["logical"]["height"]
            w, h = on[oid]["logical"]["width"], on[oid]["logical"]["height"]
            center = cfg.get("align", "center") == "center"
            side = cfg.get("side") or "right"
            if side in ("left", "right"):
                x = ax - w if side == "left" else ax + aw
                y = ay + (ah - h) // 2 if center else ay
            else:
                y = ay - h if side == "above" else ay + ah
                x = ax + (aw - w) // 2 if center else ax
            pos[oid] = (x, y)
            pending.remove(oid)
    x = max((p[0] + on[i]["logical"]["width"] for i, p in pos.items()), default=0)
    for oid in pending:
        pos[oid] = (x, 0)
        x += on[oid]["logical"]["width"]
    dx = -min(p[0] for p in pos.values())
    dy = -min(p[1] for p in pos.values())
    return {i: (p[0] + dx, p[1] + dy) for i, p in pos.items()}


def apply(place, outs):
    by_id = {ident(o): o for o in outs.values()}
    for oid, cfg in place["outputs"].items():
        o = by_id.get(oid)
        if not o:
            continue
        name = o["name"]
        if not cfg["enabled"]:
            if enabled(o):
                niri("output", name, "off")
            continue
        if not enabled(o):
            niri("output", name, "on")
        m = current_mode(o)
        if cfg.get("mode") and (not m or mode_str(m) != cfg["mode"]):
            niri("output", name, "mode", cfg["mode"])
        if abs((o.get("logical") or {}).get("scale", 0) - cfg["scale"]) > 1e-3:
            niri("output", name, "scale", f'{cfg["scale"]:g}')
    outs = outputs()
    by_id = {ident(o): o for o in outs.values()}
    on = {oid: by_id[oid] for oid, cfg in place["outputs"].items()
          if cfg["enabled"] and oid in by_id and enabled(by_id[oid])}
    for oid, (x, y) in positions(place, on).items():
        place["outputs"][oid]["pos"] = [x, y]
        lg = on[oid]["logical"]
        if (lg["x"], lg["y"]) != (x, y):
            niri("output", on[oid]["name"], "position", "set", str(x), str(y))


def commit(key, place, state, outs):
    apply(place, outs)
    state[key] = place
    save_state(state)
    write_kanshi(state)
    subprocess.Popen(["kanshictl", "reload"], stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def presets(outs):
    lap = [o for o in ordered(outs) if is_laptop(o["name"])]
    ext = [o for o in ordered(outs) if not is_laptop(o["name"])]
    if not lap or not ext:
        return []
    L, E = lap[0], ext
    li, ei = ident(L), [ident(o) for o in E]
    names = [short(o) for o in E]
    out = []

    def chain(order):
        cfg = {}
        for prev, cur in zip(order, order[1:]):
            cfg[cur] = (True, prev, "right")
        return cfg

    if len(E) >= 2:
        cfg = {li: (True, None, None), ei[0]: (True, li, "left"), ei[1]: (True, li, "right")}
        for prev, cur in zip(ei[1:], ei[2:]):
            cfg[cur] = (True, prev, "right")
        out.append(("middle", " · ".join([names[0], short(L), *names[1:]]), cfg))
    out.append(("right", " · ".join([short(L), *names]), {li: (True, None, None), **chain([li, *ei])}))
    out.append(("left", " · ".join([*names, short(L)]),
                {li: (True, None, None), **{ei[-1]: (True, li, "left")},
                 **{a: (True, b, "left") for a, b in zip(ei[:-1], ei[1:])}}))
    if len(E) == 1:
        out.append(("above", f"{names[0]} " + where("above", L),
                    {li: (True, None, None), ei[0]: (True, li, "above")}))
    only_ext = {li: (False, None, None), ei[0]: (True, None, "right")}
    for prev, cur in zip(ei, ei[1:]):
        only_ext[cur] = (True, prev, "right")
    out.append(("external", " · ".join(names) + "  (" + _("{} off").format(short(L)) + ")", only_ext))
    out.append(("laptop", _("Only {}").format(short(L)),
                {li: (True, None, None), **{i: (False, None, None) for i in ei}}))
    return out


def ddc_info(names):
    try:
        cache = json.loads(DDC_CACHE.read_text())
    except (OSError, ValueError):
        cache = {}
    want = [n for n in names if not is_laptop(n)]
    if all(n in cache for n in want):
        return cache
    bus = None
    for line in run("ddcutil", "detect", "--terse").stdout.splitlines():
        line = line.strip()
        m = re.match(r"I2C bus:\s+/dev/i2c-(\d+)", line)
        if m:
            bus = m.group(1)
        m = re.match(r"DRM connector:\s+card\d+-(\S+)", line)
        if m and bus:
            cache.setdefault(m.group(1), {"bus": bus, "max": None})
    for n in want:
        cache.setdefault(n, {"bus": None, "max": None})
    DDC_CACHE.write_text(json.dumps(cache))
    return cache


def ddc_read(name):
    info = ddc_info([name]).get(name) or {}
    if not info.get("bus"):
        return None
    parts = run("ddcutil", "--bus", info["bus"], "getvcp", "10", "--brief").stdout.split()
    if len(parts) >= 5 and parts[3].isdigit() and parts[4].isdigit() and int(parts[4]):
        cache = ddc_info([name])
        cache[name]["max"] = int(parts[4])
        DDC_CACHE.write_text(json.dumps(cache))
        return round(int(parts[3]) * 100 / int(parts[4]))
    return None


def laptop_brightness():
    out = run("brightnessctl", "--class=backlight", "-m").stdout.split(",")
    return int(out[3].rstrip("%")) if len(out) > 3 else None


def brightness_of(o, cfg):
    return laptop_brightness() if is_laptop(o["name"]) else cfg.get("brightness")


def set_brightness(o, pct):
    if is_laptop(o["name"]):
        run("brightnessctl", "--class=backlight", "set", f"{pct}%")
        return True
    info = ddc_info([o["name"]]).get(o["name"]) or {}
    if not info.get("bus"):
        return False
    value = round(pct * (info.get("max") or 100) / 100)
    subprocess.Popen(["ddcutil", "--bus", info["bus"], "--noverify", "setvcp", "10", str(value)],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return True


def mirrors():
    try:
        data = json.loads(MIRRORS.read_text())
    except (OSError, ValueError):
        return {}
    return {t: pid for t, pid in data.items() if Path(f"/proc/{pid}").exists()}


def stop_mirror(target):
    data = mirrors()
    pid = data.pop(target, None)
    if pid:
        run("kill", str(pid))
    MIRRORS.write_text(json.dumps(data))


def start_mirror(source, target):
    if target in mirrors():
        return
    try:
        proc = subprocess.Popen(["wl-mirror", source], stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL, start_new_session=True)
    except FileNotFoundError:
        run("notify-send", _("Mirroring"), _("wl-mirror is not installed"))
        return
    data = mirrors()
    data[target] = proc.pid
    MIRRORS.write_text(json.dumps(data))
    for _x in range(50):
        time.sleep(0.1)
        try:
            wins = json.loads(niri("--json", "windows").stdout)
        except ValueError:
            continue
        win = next((w for w in wins if w.get("pid") == proc.pid), None)
        if win:
            niri("action", "focus-window", "--id", str(win["id"]))
            niri("action", "move-window-to-monitor", target)
            niri("action", "fullscreen-window", "--id", str(win["id"]))
            return


def sync_mirrors(place, outs):
    lap = next((o for o in ordered(outs) if is_laptop(o["name"]) and enabled(o)), None)
    for o in outs.values():
        if is_laptop(o["name"]):
            continue
        want = place["outputs"].get(ident(o), {}).get("show") == "mirror" and lap and enabled(o)
        if want:
            start_mirror(lap["name"], o["name"])
        elif o["name"] in mirrors():
            stop_mirror(o["name"])


def restore():
    time.sleep(1)
    outs = outputs()
    place = load_state().get(place_key(outs))
    if not place:
        return 0
    for o in outs.values():
        b = place["outputs"].get(ident(o), {}).get("brightness")
        if b is not None and enabled(o):
            set_brightness(o, b)
    sync_mirrors(place, outs)
    return 0


def caffeine_on():
    return run("systemctl", "--user", "is-active", "--quiet", CAFFEINE).returncode == 0


def caffeine_set(on):
    res = run("systemctl", "--user", "start", CAFFEINE if on else "swayidle.service")
    if res.returncode != 0:
        run("notify-send", "-u", "critical", _("Caffeine"), res.stderr.strip() or _("Could not switch"))
    run("pkill", f"-RTMIN+{CAFFEINE_SIGNAL}", "-x", "waybar")


def scheme(outs, highlight=None, bands=2):
    on = [o for o in outs.values() if enabled(o)]
    if not on:
        return ""
    unit = max(o["logical"]["width"] for o in on) / 18
    minx = min(o["logical"]["x"] for o in on)
    rows = []
    for o in sorted(on, key=lambda o: o["logical"]["y"]):
        top, bottom = o["logical"]["y"], o["logical"]["y"] + o["logical"]["height"]
        for r in rows:
            if top < r[1] and bottom > r[0]:
                r[0], r[1] = min(r[0], top), max(r[1], bottom)
                r[2].append(o)
                break
        else:
            rows.append([top, bottom, [o]])
    rows = [r[2] for r in sorted(rows, key=lambda r: r[0])]
    lines = []
    for row in rows:
        top = mid = bot = ""
        col = 0
        for o in sorted(row, key=lambda o: o["logical"]["x"]):
            start = round((o["logical"]["x"] - minx) / unit)
            width = max(10, round(o["logical"]["width"] / unit))
            gap = " " * max(0, start - col)
            inner = width - 2
            label = short(o)
            if len(label) > inner:
                label = label.split()[-1]
            label = label[:inner].center(inner)
            box = ["┌" + "─" * inner + "┐", "│" + html.escape(label) + "│", "└" + "─" * inner + "┘"]
            if highlight and o["name"] == highlight:
                box = [f'<span color="{ACCENT}">{b}</span>' for b in box]
            top, mid, bot = top + gap + box[0], mid + gap + box[1], bot + gap + box[2]
            col = max(col, start) + width
        lines += [top, mid, bot]
    while len(lines) < bands * 3:
        lines = ([""] if len(lines) % 2 == 0 else []) + lines + ([""] if len(lines) % 2 else [])
    vis = [len(re.sub(r"<[^>]+>", "", html.unescape(line))) for line in lines]
    w = max(vis)
    return "\u2028".join(line + " " * (w - n) for line, n in zip(lines, vis))


SHOW_LAPTOP = [("on", _("on")), ("off", _("off"))]
SHOW_EXTERNAL = [("extend", _("extended")), ("mirror", _("mirror")), ("off", _("off"))]


class Menu:

    def __init__(self, view, prompt, outs, highlight=None):
        self.view, self.prompt, self.outs, self.highlight = view, prompt, outs, highlight
        self.rows = []

    def add(self, text, info, active=False, nonselectable=False):
        self.rows.append((text, info, active, nonselectable))

    def print(self, focus=None):
        option("prompt", self.prompt)
        option("message", scheme(self.outs, self.highlight))
        option("data", self.view)
        option("no-custom", "true")
        option("use-hot-keys", "true")
        option("keep-selection", "true")
        infos = [r[1] for r in self.rows]
        index = infos.index(focus) if focus in infos else (1 if infos and infos[0].startswith("view:") and len(infos) > 1 else 0)
        option("new-selection", str(index))
        for text, info, active, nonselectable in self.rows:
            extra = ""
            if active:
                extra += "\x1factive\x1ftrue"
            if nonselectable:
                extra += "\x1fnonselectable\x1ftrue"
            sys.stdout.write(f"{text}\0info\x1f{info}{extra}\n")


def option(key, value):
    sys.stdout.write(f"\0{key}\x1f{value}\n")


def arrows(text):
    return f"‹ {text} ›"


def show_value(o, cfg):
    if is_laptop(o["name"]):
        return "on" if cfg.get("enabled", True) else "off"
    if not cfg.get("enabled", True):
        return "off"
    return "mirror" if cfg.get("show") == "mirror" else "extend"


def out_summary(o, cfg, outs):
    if not enabled(o):
        return f"{title(o)} · {_('off')}"
    if show_value(o, cfg) == "mirror":
        return f"{title(o)} · {_('mirror')}"
    m = current_mode(o)
    return f"{title(o)} · {mode_label(m)}" if m else title(o)


def show_main(outs, place, focus):
    menu = Menu("main", _("displays"), outs)
    on = caffeine_on()
    menu.add(f'{_("Caffeine")} · {arrows(_("on") if on else _("off"))}', "adj:caffeine:", active=on)
    if len(outs) > 1:
        menu.add(_("Layouts") + "  ›", "view:presets")
    for o in ordered(outs):
        menu.add(out_summary(o, place["outputs"].get(ident(o), {}), outs) + "  ›",
                 f"view:out:{o['name']}")
    menu.print(focus or (f"view:out:{ordered(outs)[0]['name']}" if outs else None))


def show_presets(outs, place, focus):
    menu = Menu("presets", f'{_("displays")} › {_("layouts")}', outs)
    menu.add("‹ " + _("Back"), "view:main")
    for key, label, _x in presets(outs):
        menu.add(label, f"preset:{key}", active=(key == place.get("preset")))
    menu.print(focus)


def show_output(o, outs, place, focus):
    name = o["name"]
    cfg = place["outputs"].get(ident(o), {})
    menu = Menu(f"out:{name}", f'{_("displays")} › {title(o)}', outs, highlight=name)
    menu.add("‹ " + _("Back"), "view:main")
    values = SHOW_LAPTOP if is_laptop(name) else SHOW_EXTERNAL
    menu.add(f'{_("Screen")} · {arrows(dict(values)[show_value(o, cfg)])}', f"adj:show:{name}")
    if enabled(o):
        b = brightness_of(o, cfg)
        menu.add(f'{_("Brightness")} · {arrows(f"{b}%" if b is not None else "—")}', f"adj:bright:{name}")
        menu.add(f'{_("Scale")} · {arrows("×%g" % o["logical"]["scale"])}', f"adj:scale:{name}")
        m = current_mode(o)
        menu.add(f'{_("Resolution and refresh rate")} · {mode_label(m) if m else "—"}  ›',
                 f"view:out:{name}:mode")
        anchor = next((x for x in outs.values() if ident(x) == cfg.get("rel")), None)
        if not is_laptop(name):
            text = where(cfg.get("side"), anchor) if anchor else _("primary")
            menu.add(f'{_("Position")} · {text}  ›', f"view:out:{name}:place")
    menu.print(focus)


def show_choice(o, what, outs, place, focus):
    name = o["name"]
    cfg = place["outputs"].get(ident(o), {})
    labels = {"bright": _("brightness"), "mode": _("resolution and refresh rate"),
              "scale": _("scale"), "place": _("position"), "rel": _("relative to")}
    menu = Menu(f"out:{name}:{what}", f'{_("displays")} › {short(o)} › {labels[what]}', outs, highlight=name)
    back = f"view:out:{name}:place" if what == "rel" else f"view:out:{name}"
    menu.add("‹ " + _("Back"), back)
    if what == "bright":
        cur = brightness_of(o, cfg)
        if cur is None and not is_laptop(name):
            cur = ddc_read(name)
            if cur is not None:
                place["outputs"][ident(o)]["brightness"] = cur
                state = load_state()
                state[place_key(outs)] = place
                save_state(state)
        if cur is None and not is_laptop(name):
            menu.add(_("The monitor does not answer over DDC/CI — use its buttons"),
                     back, nonselectable=True)
        else:
            for pct in range(100, 0, -10):
                menu.add(f"{pct}%", f"set:{name}:bright:{pct}",
                         active=cur is not None and abs(cur - pct) < 5)
    elif what == "mode":
        m = current_mode(o)
        for mode in o["modes"]:
            label = mode_label(mode) + (" · " + _("native") if mode.get("is_preferred") else "")
            menu.add(label, f"set:{name}:mode:{mode_str(mode)}", active=(mode == m))
    elif what == "scale":
        for sc in SCALES:
            menu.add(f"×{sc:g}", f"set:{name}:scale:{sc:g}",
                     active=abs(o["logical"]["scale"] - sc) < 1e-3)
    elif what == "place":
        anchor = next((x for x in outs.values() if ident(x) == cfg.get("rel")), None)
        menu.add(f'{_("Relative to")} · {short(anchor) if anchor else "—"}  ›', f"view:out:{name}:rel")
        side = cfg.get("side") or "right"
        for key, label in SIDES:
            menu.add(label, f"set:{name}:side:{key}", active=(key == side))
        menu.add(f'{_("Alignment")} · {arrows(dict(ALIGNS)[cfg.get("align", "center")])}',
                 f"adj:align:{name}")
    elif what == "rel":
        for x in ordered(outs):
            if x["name"] == name or not enabled(x):
                continue
            ok = chain_ok(place, ident(o), ident(x))
            menu.add(f"{short(x)} · {title(x)}" + ("" if ok else " · " + _("placed relative to this one")),
                     f"set:{name}:rel:{x['name']}", active=(ident(x) == cfg.get("rel")),
                     nonselectable=not ok)
    if focus is None:
        focus = next((r[1] for r in menu.rows if r[2]), None)
    menu.print(focus)


def show(view, focus=None):
    outs = outputs()
    state = load_state()
    key, place = current_place(outs, state)
    parts = view.split(":")
    o = outs.get(parts[1]) if parts[0] == "out" and len(parts) > 1 else None
    if parts[0] == "presets" and len(outs) > 1:
        show_presets(outs, place, focus)
    elif o and len(parts) == 3 and enabled(o) and not (parts[2] == "place" and is_laptop(o["name"])):
        show_choice(o, parts[2], outs, place, focus)
    elif o:
        show_output(o, outs, place, focus)
    else:
        show_main(outs, place, focus)


def parent(view):
    parts = view.split(":")
    if parts[0] == "out" and len(parts) == 3:
        return f"out:{parts[1]}:place" if parts[2] == "rel" else f"out:{parts[1]}"
    return None if view == "main" else "main"


def step(values, current, delta, wrap=False):
    i = values.index(current) if current in values else 0
    i = (i + delta) % len(values) if wrap else max(0, min(len(values) - 1, i + delta))
    return values[i]


def adjust(what, name, delta, wrap=False):
    if what == "caffeine":
        caffeine_set(not caffeine_on())
        return
    outs = outputs()
    state = load_state()
    key, place = current_place(outs, state)
    o = outs.get(name)
    if not o:
        return
    cfg = place["outputs"][ident(o)]
    if what == "bright":
        cur = brightness_of(o, cfg)
        if cur is None and not is_laptop(name):
            cur = ddc_read(name)
        if cur is None:
            return
        new = max(10, min(100, round(cur / 10) * 10 + 10 * delta))
        if set_brightness(o, new):
            cfg["brightness"] = new
            state[key] = place
            save_state(state)
        return
    if what == "scale":
        cur = min(SCALES, key=lambda sc: abs(sc - o["logical"]["scale"]))
        cfg["scale"] = step(SCALES, cur, delta)
    elif what == "align":
        cfg["align"] = step([a for a, _x in ALIGNS], cfg.get("align", "center"), delta, wrap=True)
    elif what == "show":
        values = [v for v, _x in (SHOW_LAPTOP if is_laptop(name) else SHOW_EXTERNAL)]
        new = step(values, show_value(o, cfg), delta, wrap=True)
        others_on = [x for x in outs.values() if x["name"] != name and enabled(x)]
        if new == "off" and not others_on:
            return
        cfg["enabled"] = new != "off"
        if not is_laptop(name):
            cfg["show"] = new
    place["preset"] = None
    commit(key, place, state, outs)
    sync_mirrors(place, outputs())


def act(info):
    kind, _x, rest = info.partition(":")
    if kind == "view":
        return rest, None
    if kind == "adj":
        what, _x, name = rest.partition(":")
        if what in ("bright", "scale"):
            return f"out:{name}:{what}", None
        adjust(what, name, +1, wrap=True)
        return None, info
    outs = outputs()
    state = load_state()
    key, place = current_place(outs, state)
    by_name = {o["name"]: o for o in outs.values()}

    if kind == "preset":
        chosen = dict((k, cfg) for k, _x, cfg in presets(outs)).get(rest)
        if chosen:
            for oid, (on, rel, side) in chosen.items():
                place["outputs"][oid].update(enabled=on, rel=rel, side=side, align="center",
                                             show="extend" if on else "off")
            place["preset"] = rest
            commit(key, place, state, outs)
            sync_mirrors(place, outputs())
        return "presets", info

    if kind == "set":
        name, what, value = rest.split(":", 2)
        o = by_name.get(name)
        if not o:
            return "main", None
        cfg = place["outputs"][ident(o)]
        if what == "bright":
            if set_brightness(o, int(value)):
                cfg["brightness"] = int(value)
                save_state(state)
            return f"out:{name}:bright", info
        if what == "mode":
            cfg["mode"] = value
        elif what == "scale":
            cfg["scale"] = float(value)
        elif what == "side":
            cfg["side"] = value
        elif what == "rel":
            anchor = by_name.get(value)
            if anchor and chain_ok(place, ident(o), ident(anchor)):
                cfg["rel"] = ident(anchor)
        place["preset"] = None
        commit(key, place, state, outputs())
        if what == "rel":
            return f"out:{name}:place", f"view:out:{name}:rel"
        return {"mode": f"out:{name}:mode", "scale": f"out:{name}:scale"}.get(
            what, f"out:{name}:place"), info
    return "main", None


def our_rofi():
    for pid in run("pgrep", "-x", "rofi").stdout.split():
        try:
            args = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
        except OSError:
            continue
        if any(a.decode(errors="replace").endswith(f"{SELF} list") for a in args):
            return pid
    return None


def launch():
    pid = our_rofi()
    if pid:
        run("kill", pid)
        sys.exit(0)
    mode = _("displays")
    cmd = ["rofi", "-show", mode, "-modes", f"{mode}:{SELF} list",
           "-replace", "-no-show-icons",
           "-kb-cancel", "Control+g,Control+bracketleft", "-kb-custom-3", "Escape",
           "-kb-move-char-back", "Control+b", "-kb-move-char-forward", "Control+f",
           "-kb-custom-4", "Left", "-kb-custom-5", "Right"]
    if THEME.exists():
        cmd += ["-theme", str(THEME)]
    os.execvp("rofi", cmd)


def main():
    if len(sys.argv) < 2:
        launch()
    if sys.argv[1] == "restore":
        return restore()
    if sys.argv[1] == "caffeine":
        print(COFFEE if caffeine_on() else "")
        return 0
    if sys.argv[1] != "list":
        sys.exit(__doc__)
    retv = int(os.environ.get("ROFI_RETV", "0"))
    info = os.environ.get("ROFI_INFO", "")
    view = os.environ.get("ROFI_DATA") or "main"
    focus = None
    if retv == ESC:
        focus = f"view:{view}"
        view = parent(view)
        if view is None:
            return 0
    elif retv in (LEFT, RIGHT):
        focus = info
        if info.startswith("adj:"):
            what, _x, name = info[4:].partition(":")
            adjust(what, name, -1 if retv == LEFT else +1)
    elif retv == SELECT and info:
        new_view, focus = act(info)
        view = new_view or view
    show(view, focus)
    return 0


if __name__ == "__main__":
    sys.exit(main())
