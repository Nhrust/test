#!/usr/bin/env python3
"""zen-speed — Waybar module: download speed of the physical network cards."""
import glob
import os
import time

INTERVAL = 2


def rx_bytes():
    total = 0
    for dev in glob.glob("/sys/class/net/*"):
        if not os.path.exists(os.path.join(dev, "device")):
            continue
        try:
            with open(os.path.join(dev, "statistics/rx_bytes")) as f:
                total += int(f.read())
        except OSError:
            pass
    return total


def human(rate):
    for unit in ("B", "KB", "MB", "GB"):
        if rate < 1024 or unit == "GB":
            return f"{rate:5.1f} {unit:<2}"
        rate /= 1024


prev = rx_bytes()
while True:
    time.sleep(INTERVAL)
    cur = rx_bytes()
    print(human(max(cur - prev, 0) / INTERVAL), flush=True)
    prev = cur
