#!/bin/sh
# zen — maintenance commands of the Zen desktop.
LIB="$HOME/.local/lib/zen"

case ${1:-} in
	apply) shift; exec "$LIB/apply" "$@" ;;
	diff) shift; exec "$LIB/diff" "$@" ;;
	doctor) shift; exec "$LIB/doctor" "$@" ;;
	gtklock) shift; exec "$LIB/gtklock-build" "$@" ;;
	*)
		cat <<EOF
usage: zen COMMAND

  apply [--user]     write what follows ~/.config/zen/zen.conf: colours of every
                     program, the console and the boot menu (--user: home only)
  diff [PATH...]     what differs from the repository deploy.sh last used
  doctor             check services, lock screen, colours, panel, repository
  gtklock [--force]  rebuild zen-module when gtklock or its source changed

menus:  zen-center  zen-displays  zen-audio  zen-clipboard  zen-power
other:  zen-lock  zen-step
EOF
		[ -z "${1:-}" ] || [ "$1" = help ] || [ "$1" = -h ] || [ "$1" = --help ] || exit 1 ;;
esac
