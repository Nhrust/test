#!/usr/bin/env python3
"""zen-palette — write the palette from ~/.config/zen/zen.conf into the colour
files that Rofi and Waybar import (rofi/zen-colors.rasi, waybar/zen-colors.css)."""
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share") / "zen/python"))
import zen  # noqa: E402

colors = zen.palette()
colors["urgent"] = colors["error"]

rasi = zen.CONFIG_HOME / "rofi/zen-colors.rasi"
rasi.parent.mkdir(parents=True, exist_ok=True)
rasi.write_text("* {\n" + "".join(f"    zen-{k}: {v};\n" for k, v in colors.items()) + "}\n")

css = zen.CONFIG_HOME / "waybar/zen-colors.css"
css.parent.mkdir(parents=True, exist_ok=True)
css.write_text("".join(f"@define-color zen-{k} {v};\n" for k, v in colors.items()))

print(rasi)
print(css)
