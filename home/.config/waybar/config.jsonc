{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 0,
    "expand-left": true,
    "expand-right": true,
    // modules-left and the monitoring modules: zen-vitals.jsonc, made by "zen apply"
    // from [panel] vitals in zen.conf (right click on a monitoring module changes it)
    "include": ["~/.config/waybar/zen-vitals.jsonc"],
    "modules-center": [
        "mpris",
        "custom/date",
        "custom/dnd",
        "custom/weather"
    ],
    "modules-right": [
        "custom/gap-r1",
        "tray",
        "custom/gap-r2",
        "custom/hotspot",
        "custom/net",
        "custom/lang",
        "group/light",
        "group/sound",
        "group/power"
    ],
    "niri/workspaces": {
        "format": ""
    },
    "custom/gap-l1": {
        "format": " ",
        "interval": 86400,
        "expand": true,
        "tooltip": false
    },
    "custom/gap-l2": {
        "format": " ",
        "interval": 86400,
        "expand": true,
        "tooltip": false
    },
    "custom/gap-r1": {
        "format": " ",
        "interval": 86400,
        "expand": true,
        "tooltip": false
    },
    "custom/gap-r2": {
        "format": " ",
        "interval": 86400,
        "expand": true,
        "tooltip": false
    },
    "mpris": {
        "format": "{player_icon} {status_icon}",
        "format-paused": "{player_icon} {status_icon}",
        "status-icons": {
            "playing": "󰐊",
            "paused": "󰏤"
        },
        "player-icons": {
            "default": "󰝚",
            "firefox": "󰈹",
            "chromium": "󰊯",
            "spotify": "󰓇",
            "vlc": "󰕼",
            "telegram": ""
        },
        "tooltip": false,
        "on-click": "~/.local/bin/zen-audio",
        "on-click-right": "playerctl --player=playerctld play-pause",
        "on-click-middle": "~/.local/bin/zen-audio player-mute",
        "on-scroll-up": "playerctl --player=playerctld previous",
        "on-scroll-down": "playerctl --player=playerctld next",
        "smooth-scrolling-threshold": 4,
        "reverse-scrolling": true
    },
    "custom/date": {
        "on-click": "~/.local/bin/zen-center",
        "on-click-right": "~/.local/bin/zen-center dnd toggle",
        "on-click-middle": "~/.local/bin/zen-center clear",
        "exec": "~/.local/lib/zen/bar/date",
        "interval": 1,
        "tooltip": false
    },
    "custom/weather": {
        "exec": "~/.local/lib/zen/bar/weather",
        "on-click": "~/.local/bin/zen-center",
        "on-click-right": "pkill -RTMIN+13 -x waybar; ~/.local/bin/zen-center fetch",
        "signal": 13,
        "interval": 900,
        "tooltip": false
    },
    "custom/dnd": {
        "exec": "~/.local/bin/zen-center dnd",
        "signal": 11,
        "interval": 10,
        "on-click": "~/.local/bin/zen-center",
        "on-click-right": "~/.local/bin/zen-center dnd toggle",
        "on-click-middle": "~/.local/bin/zen-center clear",
        "tooltip": false
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "custom/hotspot": {
        "exec": "~/.local/lib/zen/bar/hotspot",
        "interval": 5,
        "signal": 14,
        "on-click": "~/.local/bin/zen-network open hotspot",
        "tooltip": false
    },
    "custom/net": {
        "exec": "~/.local/lib/zen/bar/net icon",
        "interval": 5,
        "on-click": "~/.local/bin/zen-network",
        "tooltip": false
    },
    "custom/lang": {
        "exec": "~/.local/lib/zen/bar/lang",
        "on-click": "niri msg action switch-layout next",
        "restart-interval": 2,
        "tooltip": false
    },
    "wireplumber": {
        "format": "{volume:>3}%",
        "format-muted": "{volume:>3}%",
        "on-update": "pkill -RTMIN+8 -x waybar",
        "reverse-scrolling": true,
        "on-scroll-up": "~/.local/bin/zen-step volume up",
        "on-scroll-down": "~/.local/bin/zen-step volume down",
        "on-click": "~/.local/bin/zen-audio",
        "on-click-right": "~/.local/bin/zen-audio mute",
        "tooltip": false,
        "format-icons": [
            "󰕿",
            "󰖀",
            "󰕾"
        ]
    },
    "backlight": {
        "format": "{percent:>3}%",
        "on-update": "pkill -RTMIN+9 -x waybar",
        "on-click": "~/.local/bin/zen-displays",
        "on-click-right": "~/.local/bin/zen-displays caffeine toggle",
        "on-scroll-up": "~/.local/bin/zen-step brightness up",
        "on-scroll-down": "~/.local/bin/zen-step brightness down",
        "reverse-scrolling": true,
        "tooltip": false
    },
    "group/light": {
        "orientation": "horizontal",
        "modules": [
            "image#brightness",
            "backlight",
            "custom/caffeine"
        ]
    },
    "group/sound": {
        "orientation": "horizontal",
        "modules": [
            "image#volume",
            "wireplumber",
            "custom/mic"
        ]
    },
    "custom/mic": {
        "exec": "~/.local/lib/zen/bar/mic",
        "return-type": "json",
        "signal": 12,
        "interval": 5,
        "on-click": "~/.local/bin/zen-audio mic-mute",
        "tooltip": false
    },
    "custom/caffeine": {
        "exec": "~/.local/bin/zen-displays caffeine",
        "signal": 10,
        "interval": 30,
        "on-click": "~/.local/bin/zen-displays",
        "on-click-right": "~/.local/bin/zen-displays caffeine toggle",
        "tooltip": false
    },
    "image#brightness": {
        "exec": "~/.local/lib/zen/bar/level brightness",
        "on-click": "~/.local/bin/zen-displays",
        "on-click-right": "~/.local/bin/zen-displays caffeine toggle",
        "size": 14,
        "signal": 9,
        "interval": 30,
        "on-scroll-up": "~/.local/bin/zen-step brightness up",
        "on-scroll-down": "~/.local/bin/zen-step brightness down",
        "reverse-scrolling": true,
        "tooltip": false
    },
    "image#volume": {
        "exec": "~/.local/lib/zen/bar/level volume",
        "size": 14,
        "signal": 8,
        "interval": 30,
        "on-click": "~/.local/bin/zen-audio",
        "on-click-right": "~/.local/bin/zen-audio mute",
        "on-scroll-up": "~/.local/bin/zen-step volume up",
        "on-scroll-down": "~/.local/bin/zen-step volume down",
        "reverse-scrolling": true,
        "tooltip": false
    },
    "group/power": {
        "orientation": "horizontal",
        "modules": [
            "custom/profile",
            "battery",
            "custom/powerbtn"
        ]
    },
    "custom/powerbtn": {
        "format": "󰐥",
        "on-click": "~/.local/bin/zen-power",
        "on-click-right": "~/.local/lib/zen/bar/profile next",
        "on-scroll-up": "~/.local/lib/zen/bar/profile up",
        "on-scroll-down": "~/.local/lib/zen/bar/profile down",
        "reverse-scrolling": true,
        "tooltip": false
    },
    "custom/profile": {
        "exec": "~/.local/lib/zen/bar/profile",
        "on-click": "~/.local/bin/zen-power",
        "on-click-right": "~/.local/lib/zen/bar/profile next",
        "on-scroll-up": "~/.local/lib/zen/bar/profile up",
        "on-scroll-down": "~/.local/lib/zen/bar/profile down",
        "reverse-scrolling": true,
        "tooltip": false
    },
    "battery": {
        "bat": "BAT0",
        "on-click": "~/.local/bin/zen-power",
        "on-click-right": "~/.local/lib/zen/bar/profile next",
        "on-scroll-up": "~/.local/lib/zen/bar/profile up",
        "on-scroll-down": "~/.local/lib/zen/bar/profile down",
        "reverse-scrolling": true,
        "interval": 30,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "{icon} {capacity:>3}%",
        "format-charging": "󰂄 {capacity:>3}%",
        "tooltip": false,
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    }
}
