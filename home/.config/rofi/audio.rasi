@import "zen.rasi"

window {
    height: calc( 141px + 1em + 10 * ( 1.2em floor 1px ) + 1em + 19px );
}

mainbox {
    children: [ switcher, inputbar, message, listview ];
}

inputbar {
    children: [ prompt ];
}

message {
    padding: 4px 0px 8px 0px;
    border: 0px 0px 1px 0px;
    border-color: @zen-line;
}

textbox {
    font: "JetBrainsMono Nerd Font 10";
    text-color: @zen-muted;
    horizontal-align: 0.5;
}

button-zen-audio {
    text-color: @zen-accent;
}
