@import "zen.rasi"

window {
    height: calc( 141px + 1em + 10 * ( 1.2em floor 1px ) + 1em + 19px );
}

mainbox {
    children: [ switcher, listview ];
}

listview {
    columns: 4;
    lines: 2;
    spacing: 8px;
    fixed-columns: true;
    flow: horizontal;
}

element {
    orientation: vertical;
    children: [ element-icon, element-text ];
    spacing: 12px;
    /* two rows of tiles fill the window, which is as tall as the other menus */
    padding: calc( ( 101px + 1em + 10 * ( 1.2em floor 1px ) ) / 4 - 30px - ( 1.2em floor 1px ) / 2 ) 4px;
    border: 1px;
    border-color: @zen-line;
}
element-icon {
    size: 48px;
}
element-text {
    horizontal-align: 0.5;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @zen-fg;
}
element selected.normal {
    background-color: transparent;
    text-color: @zen-fg;
    border-color: @zen-accent;
}

element normal.active, element alternate.active {
    background-color: transparent;
    text-color: @zen-accent;
}
element selected.active {
    background-color: transparent;
    text-color: @zen-accent;
    border-color: @zen-accent;
}

element normal.urgent, element alternate.urgent, element selected.urgent {
    background-color: transparent;
    text-color: @zen-error;
    border-color: @zen-error;
}

button-zen-power {
    text-color: @zen-accent;
}
