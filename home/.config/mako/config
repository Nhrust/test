max-history=20
font=JetBrainsMono Nerd Font 12
background-color=#0b0b0b
text-color=#dedede
border-color=#555555
border-size=1
border-radius=6
padding=10
margin=10
width=360
anchor=top-right
default-timeout=5000
icon-path=/usr/share/icons/Papirus-Dark
max-icon-size=32

[urgency=low]
text-color=#bebebe

[urgency=high]
border-color=#f3a3bb
default-timeout=0

[mode=do-not-disturb]
invisible=1
on-notify=exec pkill -RTMIN+11 -x waybar
