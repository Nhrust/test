# Settings for the zen scripts. Every key is optional: delete a line to get
# the default. Language, units, first day of the week and 12/24-hour time
# follow the locale (LANG, LC_MESSAGES, LC_TIME, LC_MEASUREMENT).

[general]
# Locale for the zen scripts only, e.g. ru_RU.UTF-8; empty — the system locale.
# It must be generated (listed by "locale -a").
locale =

[panel]
# Monitoring modules on the left of the panel, in order, at most six; a right
# click on one of them opens a menu that changes this line. Keys: cpu cpufreq
# load gpu vram memory mempct swap temp tempcpu tempgpu tempnvme fan speed
# upload disk diskio power uptime
vitals = cpu, gpu, memory, temp, speed

[weather]
# City name or "latitude,longitude"; empty — detect by IP address.
location =
# Name to show in the menu; empty — the location as written or the detected city.
name =
# Contact for api.met.no (https://docs.api.met.no/doc/TermsOfService).
contact =

# Colours of every program, the console and the boot menu. After a change
# run "zen apply"; programs that cannot reload pick it up on restart.
[palette]
bg = #0b0b0b
fg = #dedede
muted = #bebebe
line = #555555
accent = #bdb3fa
critical = #f3a3bb
error = #f7a692
info = #69cee6
success = #8ed09c
warning = #ebb077
# darker than bg: sunken areas in Qt and Kvantum
deep = #030303
# the panel background
bar = #000000
# the border of unfocused windows
inactive = #2e2e2e

# Terminal colours (foot, the console, the boot menu). By default they follow
# the palette: color0 = bg, color1 = error, color2 = success, color3 = warning,
# color4 = accent, color5 = critical, color6 = info, color7 = fg, color8 = line,
# dim0 = deep, dim7 = muted. Set any of color0…color15 or dim0…dim7 to a colour
# or to a palette name to change it.
[terminal]
