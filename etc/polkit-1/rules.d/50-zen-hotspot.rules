// The network menu starts and stops zen-hotspot.service (the hotspot interface)
// without a password, for a member of wheel sitting at this computer. Nothing
// else changes: any other unit still asks.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "zen-hotspot.service" &&
        (action.lookup("verb") == "start" || action.lookup("verb") == "stop") &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
